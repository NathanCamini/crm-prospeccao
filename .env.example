# Copie para .env e ajuste. O .env nunca vai para o git.

# --- Interface
# Endereço e porta no seu computador. Mantenha 127.0.0.1; para acesso pela rede,
# coloque um proxy com HTTPS na frente e defina CRM_COOKIE_SECURE=true.
CRM_ENDERECO=127.0.0.1
CRM_PORTA=8080

# --- HTTPS (perfil "https"): domínio que aponta para esta máquina, com as portas 80 e 443 abertas.
# Ligue também CRM_COOKIE_SECURE=true. Se 172.31.247.x colidir com outra rede sua, troque CRM_REDE_BORDA.
CRM_DOMINIO=
# CRM_REDE_BORDA=172.31.247

# --- Login
# Dias que o login dura com "Manter conectado" marcado.
CRM_SESSAO_DIAS=30
CRM_COOKIE_SECURE=false

# --- Leads e horário
# De quantos em quantos minutos o CRM copia os leads do módulo 3 para a base local.
# 0 desliga a cópia automática (o super admin ainda pode sincronizar em Clientes).
CRM_SINCRONIZAR_MINUTOS=30
# Fuso usado para "hoje", agenda e relatórios.
CRM_FUSO=America/Sao_Paulo

# --- Agente classificador (módulo 2): veja agente/README.md
# Chave da API do Gemini (https://aistudio.google.com/apikey). Sem ela o agente não chama o LLM.
GEMINI_API_KEY=
# Triagem: modelo barato, roda em todas as empresas do funil. Revisão: modelo maior, só score alto ou dúvida.
AGENTE_MODELO_TRIAGEM=gemini-2.5-flash-lite
AGENTE_MODELO_REVISAO=gemini-3.8-flash
# Rotina do mês (perfil "agendador"): de quantas em quantas horas o agente verifica mês novo e lotes prontos.
AGENTE_ROTINA_HORAS=6
# Pasta data/ do módulo 1 (o agente lê exportacoes/novas/AAAA-MM/ e, se existir, gold/empresas.duckdb).
# Padrão: a do etl/ deste repositório. Se a base já foi carregada em outra pasta, aponte para ela.
MODULO1_DADOS=./etl/data

# --- Módulo 3
# CSV que o agente grava (em MODULO2_PASTA) e o módulo 3 relê sozinho quando muda.
# Deixe MODULO2_CSV vazio para ver o CRM com dados fictícios (demonstração).
MODULO2_PASTA=./modulo2_saida
MODULO2_CSV=/modulo2/classificacao.csv

# Busca de contatos das empresas-alvo (só com MODULO2_CSV): lê o site do domínio do e-mail da Receita,
# respeitando o robots.txt. De quantos em quantos minutos roda (0 = só com `python -m modulo3 enriquecer`)
# e quantas empresas trabalha por vez. Uma empresa já buscada só é buscada de novo depois de CACHE_BUSCA_DIAS.
MODULO3_ENRIQUECER=true
MODULO3_ENRIQUECER_MINUTOS=60
MODULO3_LOTE=100
CACHE_BUSCA_DIAS=90
SITE_INTERVALO_SEGUNDOS=2
# API de busca opcional, só para indicar o site de quem não tem e-mail com domínio próprio.
# nenhum | brave (paga por consulta, com crédito mensal gratuito). A Google Custom Search sai do ar em 01/01/2027.
BUSCA_API_PROVEDOR=nenhum
BRAVE_SEARCH_CHAVE=
API_LIMITE_DIARIO=100

# API do agente (serviço agente-api): monta o perfil de leads de cada produto que as empresas clientes
# descrevem em Produtos e responde às perguntas do CRM. Precisa da GEMINI_API_KEY acima.
AGENTE_API=http://agente-api:9000
AGENTE_MODELO_PERGUNTAS=gemini-2.5-flash
# Teto de custo: no máximo tantas empresas novas por mês no filtro de um produto (acima disso, a prévia
# pede uma descrição mais precisa). ~US$ 0,0001 por empresa avaliada.
AGENTE_LIMITE_PERFIL_CLIENTE=1500
# Leads no CRM: só empresas abertas há no máximo tantos dias (0 = sem limite). O que a equipe já
# trabalhou continua visível depois disso.
AGENTE_JANELA_LEADS_DIAS=180
AGENTE_TIMEOUT_SEGUNDOS=120

# --- Só Linux: dono dos arquivos em ./dados (use o seu: id -u / id -g)
# UID=1000
# GID=1000
