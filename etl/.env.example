# Copie para .env e ajuste. O arquivo .env nunca deve ir para o git.

# Pasta onde ficam bronze/, silver/, gold/ e tmp/
PROSPECCAO_DATA_DIR=./data

# Compartilhamento Nextcloud da Receita Federal (Dados Abertos do CNPJ)
# Página pública: https://arquivos.receitafederal.gov.br/index.php/s/gn672Ad4CF8N6TK?dir=/Dados/Cadastros/CNPJ
RECEITA_BASE_URL=https://arquivos.receitafederal.gov.br
RECEITA_SHARE_TOKEN=gn672Ad4CF8N6TK
RECEITA_SHARE_PATH=/Dados/Cadastros/CNPJ

# Limites do DuckDB (ajuste ao seu hardware)
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# Janela padrão (dias) para a flag is_nova na tabela gold
JANELA_NOVA_DIAS=90

# Apagar os CSVs extraídos depois que a camada silver for gerada (os .zip originais são mantidos)
APAGAR_CSV_EXTRAIDO=true

# Teto de disco temporário do DuckDB (a carga falha com mensagem em vez de lotar o disco)
DUCKDB_MAX_TEMP=20GB

# Espaço livre mínimo (GB) exigido antes de começar uma carga completa
ESPACO_MINIMO_GB=50

# Arquivos em paralelo na etapa bronze (0 = automático: núcleos do computador, até 8)
BRONZE_PROCESSOS=0
# Ao fim de cada carga, grava data/exportacoes/novas/AAAA-MM/ para o agente classificador (módulo 2).
# Compara com a silver do mês anterior; por isso mantenha MESES_MANTIDOS em 2 ou mais.
EXPORTAR_NOVAS=true
# Pasta dos arquivos temporários grandes. No Docker já vem configurada (volume interno); fora dele, padrão data/tmp
# PROSPECCAO_TRABALHO_DIR=

# ---------------- Busca complementar de contatos ----------------
# Não repetir a busca da mesma empresa dentro deste período (dias)
CACHE_BUSCA_DIAS=90
# Intervalo mínimo entre requisições ao mesmo site (segundos)
SITE_INTERVALO_SEGUNDOS=2

# API de busca oficial (opcional): nenhum | google | brave
#  - google: Custom Search JSON API. Fechada para novos clientes; o Google a desliga em 01/01/2027.
#  - brave: Brave Search API (paga por consulta, com crédito mensal gratuito). https://api.search.brave.com
BUSCA_API_PROVEDOR=nenhum
GOOGLE_CSE_CHAVE=
GOOGLE_CSE_CX=
BRAVE_SEARCH_CHAVE=
# Teto de consultas à API por dia e intervalo mínimo entre consultas (segundos)
API_LIMITE_DIARIO=100
API_INTERVALO_SEGUNDOS=1

# ---------------- Operação ----------------
# Quantos meses de bronze (zips) e silver manter depois de cada carga (0 = manter todos)
MESES_MANTIDOS=2
# Agendador: de quantas em quantas horas verificar se a Receita publicou um mês novo
AGENDADOR_INTERVALO_HORAS=24

# ---------------- Interface ----------------
# Horas que o login dura no navegador (recarregar a página não pede senha). 0 = pede sempre
SESSAO_HORAS=12
# 127.0.0.1 = só este computador. Para rede, use 0.0.0.0 ATRÁS de um proxy com HTTPS.
WEB_ENDERECO=127.0.0.1
WEB_PORTA=8501
